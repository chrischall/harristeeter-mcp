# harristeeter-mcp needs no credentials — every call rides your signed-in
# harristeeter.com browser tab through the ContextMint Bridge extension.
# All settings below are optional.

# Override the fetchproxy concentrator port. The whole fetchproxy fleet shares
# 37149 and the ContextMint Bridge extension dials that one port.
# HARRISTEETER_WS_PORT=37149

# Verbose bridge logging to stderr.
# HARRISTEETER_DEBUG=1

# IANA time zone sent with pickup-time requests (default America/New_York).
# MCP_USER_TZ=America/New_York
